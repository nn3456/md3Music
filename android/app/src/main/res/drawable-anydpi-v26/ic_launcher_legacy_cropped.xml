<?xml version="1.0" encoding="utf-8"?>
<!-- 旧版槽位自适应图标（2026-11-11 槽位拆分）：给 .LauncherLegacyIcon alias 的
     ic_launcher_legacy_cropped 提供 anydpi-v26 变体。
     层组合 = v6.0.10 拍平版（白底蓝K 居中留白 + 音符字形 monochrome），
     使用独立的 ic_launcher_legacy_* 层资源，与默认槽（LauncherModernIcon 的
     满幅重绘版）互不影响——否则 API 26+ 上两个 alias 共享同一组层，切换无效。
     API 24/25 回退仍走 drawable-nodpi/ic_launcher_legacy_cropped.png。 -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_legacy_background"/>
    <foreground android:drawable="@drawable/ic_launcher_legacy_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_legacy_monochrome"/>
</adaptive-icon>
